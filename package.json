{
  "name": "mingrid-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace=server",
    "dev:frontend": "npm run dev --workspace=client",
    "dev": "npm run dev:backend",

    "build:backend": "npm run build --workspace=server",
    "build:frontend": "npm run build --workspace=client",
    "build": "npm run build:backend && npm run build:frontend",
    "test:backend": "npm run test:e2e --workspace=server",
    "test:frontend": "npm run test:e2e --workspace=client",
    "test": "npm run test:backend",
    "docker:up": "docker compose up --build -d",

    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  }

}
